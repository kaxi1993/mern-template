{
  "name": "mern-template",
  "version": "1.0.7",
  "description": "MERN boilerplate generator. Mongo, Express, React, Node todo list web app.",
  "main": "bin/www",
  "scripts": {
    "start": "nodemon",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "nodemonConfig": {
    "ignore": [
      "client/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaxi1993/mern-template"
  },
  "jest": {
    "coverageDirectory": "./coverage/",
    "collectCoverage": true
  },
  "sideEffects": false,
  "author": "kaxi1993<kakhidze2012@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "bcrypt-nodejs": "^0.0.3",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jwt-simple": "^0.5.6",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "query-string": "^9.1.0",
    "signale": "^1.4.0"
  },
  "devDependencies": {
    "codecov": "^3.8.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4"
  }
}
